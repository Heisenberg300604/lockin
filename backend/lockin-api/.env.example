# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_ORIGINS=http://localhost:3000

# PostgreSQL (Prisma 7 and runtime adapter)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lockin?schema=public
# Use Neon’s direct (non-`-pooler`) URL for Prisma migrations only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/lockin?schema=public

# Clerk server verification. Never expose this value to browser code.
CLERK_SECRET_KEY=sk_test_replace_me

# Optional: PEM public key for networkless JWT verification.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
